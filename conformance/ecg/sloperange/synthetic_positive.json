{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "ecg.sloperange.synthetic_positive",
  "specification_id": "ecg.sloperange",
  "description": "Compute all five slope-range outputs from a small synthetic derivative ECG where every window and selected extreme can be inspected manually.",
  "inputs": [
    {
      "id": "decg",
      "value": [
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        3,
        3,
        0,
        0,
        -2,
        -2,
        0,
        0,
        0,
        0,
        6,
        6,
        0,
        0,
        -1,
        -1,
        0,
        0,
        0,
        0,
        2,
        2,
        0,
        0,
        -4,
        -4,
        0,
        0,
        0,
        0,
        0
      ]
    },
    {
      "id": "r_wave_times",
      "value": [
        0.1,
        0.2,
        0.3
      ]
    },
    {
      "id": "sampling_frequency",
      "value": 100
    }
  ],
  "parameters": {},
  "expected_outputs": [
    {
      "id": "edr",
      "fixture_id": "ecg.synthetic.sloperange_expected_edr",
      "file_role": "expected_edr_table",
      "column": "positive_edr",
      "absolute_tolerance": 0
    },
    {
      "id": "upslopes",
      "fixture_id": "ecg.synthetic.sloperange_expected_slopes",
      "file_role": "expected_slope_vectors",
      "column": "positive_upslopes",
      "absolute_tolerance": 0
    },
    {
      "id": "downslopes",
      "fixture_id": "ecg.synthetic.sloperange_expected_slopes",
      "file_role": "expected_slope_vectors",
      "column": "positive_downslopes",
      "absolute_tolerance": 0
    },
    {
      "id": "upslope_max_positions",
      "fixture_id": "ecg.synthetic.sloperange_expected_edr",
      "file_role": "expected_edr_table",
      "column": "positive_upslope_max_positions",
      "absolute_tolerance": 0
    },
    {
      "id": "downslope_min_positions",
      "fixture_id": "ecg.synthetic.sloperange_expected_edr",
      "file_role": "expected_edr_table",
      "column": "positive_downslope_min_positions",
      "absolute_tolerance": 0
    }
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "With fs = 100 Hz, short_window = 2 and long_window = 5. The complete windows give zero-based upslope maxima [9, 19, 29], downslope minima [13, 23, 33], and EDR values [5, 7, 6]. Each extreme is repeated in its window so the expected positions verify that the earliest tied sample is selected. The slope-vector fixture copies decg only inside the corresponding complete windows.",
    "reference_ids": [
      "kontaxis_edr_af_2020"
    ]
  }
}
