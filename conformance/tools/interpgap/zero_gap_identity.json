{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "tools.interpgap.zero_gap_identity",
  "specification_id": "tools.interpgap",
  "description": "A zero maximum gap preserves all input samples.",
  "inputs": [
    {
      "id": "signal",
      "fixture_id": "tools.synthetic.interpgap_cases",
      "file_role": "nonlinear",
      "column": "signal"
    },
    {
      "id": "max_gap",
      "value": 0
    }
  ],
  "parameters": {
    "method": "spline"
  },
  "expected_outputs": [
    {
      "id": "interpolated_signal",
      "value": [
        0,
        2,
        "NaN",
        9,
        20
      ],
      "absolute_tolerance": 1e-10
    }
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "A zero maximum gap preserves all input samples."
  }
}
