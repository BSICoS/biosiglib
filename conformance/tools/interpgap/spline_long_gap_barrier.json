{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "tools.interpgap.spline_long_gap_barrier",
  "specification_id": "tools.interpgap",
  "description": "The two-sample gap separates a four-knot cubic from a three-knot quadratic 1000+x squared. Neither segment uses support from the other.",
  "inputs": [
    {
      "id": "signal",
