      "value": 0.4
    }
  ],
  "parameters": {},
  "expected_outputs": [
    {
      "id": "expanded_signal",
      "value": [
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        "NaN",
        14
      ],
      "absolute_tolerance": 0
    }
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "The rounded radius is 4; take the union of clipped neighborhoods around the original missing samples and retain every other input value."
  }
