{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "ppg.pulsedet.custom_parameters",
  "specification_id": "ppg.pulsedet",
  "description": "Custom floor, refractory hold and decay fraction with a case-insensitive method name.",
  "inputs": [
    {
      "id": "dppg",
      "fixture_id": "ppg.synthetic.pulsedetection_cases",
      "file_role": "crossing_peak",
      "column": "dppg"
    },
    {
      "id": "sampling_frequency",
      "value": 10
    }
  ],
  "parameters": {
    "method": "ADAPTIVE",
    "adaptive_alpha_amp": 0.3,
    "adaptive_refract_period": 0.1,
    "adaptive_tau_rr": 1.5
  },
  "expected_outputs": [
    {
      "id": "t_d",
      "value": [
        0.2
      ],
      "absolute_tolerance": 1e-12
    },
    {
      "id": "threshold",
      "value": [
        0.6,
        0.5475,
        1,
        1,
        0.9416666666666667
      ],
      "absolute_tolerance": 1e-12
    }
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "Initial slope is 0.6*0.7/8. After the peak, the refractory hold is one sample and decay lasts round(1.5*8)=12 samples."
  }
}
