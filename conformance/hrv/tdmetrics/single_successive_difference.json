{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "hrv.tdmetrics.single_successive_difference",
  "specification_id": "hrv.tdmetrics",
  "description": "Compute defined metrics and return NaN for sample SDSD when dtk has exactly one successive difference.",
  "inputs": [
    {
      "id": "dtk",
      "value": [
        0.8,
        0.82
      ]
    }
  ],
  "parameters": {},
  "expected_outputs": [
    {
      "id": "mhr",
      "value": 74.07407407407408,
      "absolute_tolerance": 1e-10
    },
    {
      "id": "sdnn",
      "value": 14.14213562373095,
      "absolute_tolerance": 1e-10
    },
    {
      "id": "sdsd",
      "value": "NaN",
      "absolute_tolerance": 1e-10
    },
    {
      "id": "rmssd",
      "value": 20.0,
      "absolute_tolerance": 1e-10
    },
    {
      "id": "pnn50",
      "value": 0.0,
      "absolute_tolerance": 1e-10
    }
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "Expected values are calculated directly from the normative definitions for two valid intervals and one successive difference."
  }
}
