{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "hrv.fdmetrics.default_bands_irregular_grid",
  "specification_id": "hrv.fdmetrics",
  "description": "Integrate LF and default limited HF directly on an irregular grid, including the first samples at or beyond each boundary.",
  "inputs": [
    {"id": "pxx", "value": [1, 2, 3, 4, 5, 6]},
    {"id": "f", "value": [0.04, 0.10, 0.16, 0.30, 0.41, 0.50]}
  ],
  "parameters": {},
  "expected_outputs": [
    {"id": "hf", "value": 0.985, "absolute_tolerance": 1e-12},
    {"id": "lf", "value": 0.24, "absolute_tolerance": 1e-12},
    {"id": "lfn", "value": 0.19591836734693877, "absolute_tolerance": 1e-12},
    {"id": "lfhf", "value": 0.24365482233502536, "absolute_tolerance": 1e-12}
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "Original-sample trapezoids give LF = 0.09 + 0.15 = 0.24 and HF = 0.49 + 0.495 = 0.985; no 0.04, 0.15, or 0.4 sample is inserted.",
    "reference_ids": ["task_force_hrv_1996"]
  }
}
