{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "hrv.fdmetrics.separated_vlf_warning",
  "specification_id": "hrv.fdmetrics",
  "description": "Compute separated OSP metrics while aggregating both offending PSD inputs into one VLF warning.",
  "inputs": [
    {"id": "related_pxx", "value": [0.01, 0.01, 0.01, 0.01, 0.01]},
    {"id": "unrelated_pxx", "value": [0.001, 0.001, 0.001, 0.001, 0.001]},
    {"id": "f", "value": [0, 0.03, 0.05, 0.15, 0.4]}
  ],
  "parameters": {},
  "expected_outputs": [
    {"id": "urlf", "value": 0.0001, "absolute_tolerance": 1e-12},
    {"id": "re", "value": 0.004, "absolute_tolerance": 1e-12},
    {"id": "r", "value": 0.024390243902439025, "absolute_tolerance": 1e-12}
  ],
  "expected_warnings": [
    {"id": "excessive_vlf_power", "affected_ids": ["related_pxx", "unrelated_pxx"]}
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "Both constant spectra have VLF/rest ratio 0.05/0.35. Full-grid related power is 0.004, unrelated LF power is 0.0001, and the robust ratio is 0.0001/0.0041.",
    "reference_ids": ["varon_unconstrained_hrv_osp_2019", "liu_robust_cardiorespiratory_index_2019"]
  }
}
