{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "hrv.fdmetrics.related_power_threshold_rejection",
  "specification_id": "hrv.fdmetrics",
  "description": "Reject only excessive respiration-related total power while preserving valid unrelated LF power.",
  "inputs": [
    {"id": "related_pxx", "value": [0.2, 0.2, 0.2]},
    {"id": "unrelated_pxx", "value": [0.001, 0.001, 0.001]},
    {"id": "f", "value": [0.04, 0.15, 0.4]}
  ],
  "parameters": {},
  "expected_outputs": [
    {"id": "urlf", "value": 0.00011, "absolute_tolerance": 1e-12},
    {"id": "re", "value": "NaN", "absolute_tolerance": 0},
    {"id": "r", "value": "NaN", "absolute_tolerance": 0}
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "Raw re is 0.2 * 0.36 = 0.072 and exceeds 0.05. urlf is 0.001 * 0.11 = 0.00011 and remains reportable."
  }
}
