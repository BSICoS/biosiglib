{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "hrv.fdmetrics.large_single_spectrum_retained",
  "specification_id": "hrv.fdmetrics",
  "description": "Retain large single-spectrum powers instead of applying the removed 15000 compatibility rejection.",
  "inputs": [
    {"id": "pxx", "value": [1000000, 1000000, 1000000]},
    {"id": "f", "value": [0.04, 0.15, 0.4]}
  ],
  "parameters": {},
  "expected_outputs": [
    {"id": "hf", "value": 250000, "absolute_tolerance": 1e-9},
    {"id": "lf", "value": 110000, "absolute_tolerance": 1e-9},
    {"id": "lfn", "value": 0.3055555555555556, "absolute_tolerance": 1e-12},
    {"id": "lfhf", "value": 0.44, "absolute_tolerance": 1e-12}
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "The constant spectrum integrates to 110000 over LF and 250000 over HF. Both values remain valid regardless of their scale."
  }
}
