{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "hrv.fdmetrics.partial_default_hf_coverage",
  "specification_id": "hrv.fdmetrics",
  "description": "Use the final supplied sample as the default HF endpoint when the grid ends below 0.4 Hz.",
  "inputs": [
    {"id": "pxx", "value": [1, 1, 1, 1, 1]},
    {"id": "f", "value": [0.04, 0.10, 0.16, 0.30, 0.35]}
  ],
  "parameters": {},
  "expected_outputs": [
    {"id": "hf", "value": 0.19, "absolute_tolerance": 1e-12},
    {"id": "lf", "value": 0.12, "absolute_tolerance": 1e-12},
    {"id": "lfn", "value": 0.3870967741935484, "absolute_tolerance": 1e-12},
    {"id": "lfhf", "value": 0.631578947368421, "absolute_tolerance": 1e-12}
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "For a unit spectrum, powers equal covered widths: LF spans 0.04 to 0.16 and HF spans 0.16 to the last sample at 0.35."
  }
}
