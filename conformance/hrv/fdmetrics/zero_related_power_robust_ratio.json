{
  "$schema": "../../../schemas/conformance-case.schema.json",
  "id": "hrv.fdmetrics.zero_related_power_robust_ratio",
  "specification_id": "hrv.fdmetrics",
  "description": "Allow exact zero related power and return the bounded robust ratio r = 1.",
  "inputs": [
    {"id": "related_pxx", "value": [0, 0, 0]},
    {"id": "unrelated_pxx", "value": [0.001, 0.001, 0.001]},
    {"id": "f", "value": [0.04, 0.15, 0.4]}
  ],
  "parameters": {},
  "expected_outputs": [
    {"id": "urlf", "value": 0.00011, "absolute_tolerance": 1e-12},
    {"id": "re", "value": 0, "absolute_tolerance": 0},
    {"id": "r", "value": 1, "absolute_tolerance": 1e-12}
  ],
  "nan_equal": true,
  "oracle": {
    "type": "analytical",
    "description": "With re = 0 and positive urlf, urlf/(re + urlf) equals exactly one.",
    "reference_ids": ["liu_robust_cardiorespiratory_index_2019"]
  }
}
